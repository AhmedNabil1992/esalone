{
  "manifest_version": 3,
  "name": "PS Print + TCP Bridge",
  "version": "0.1.0",
  "description": "Silent receipt printing and TCP send via local bridge.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:17325/*",
    "http://localhost:17325/*",
    "https://*.test/*",
    "http://*.test/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PS Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.test/tenant/invoices/*/print*",
        "http://*.test/tenant/invoices/*/print*"
      ],
      "js": ["content-print-hook.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
