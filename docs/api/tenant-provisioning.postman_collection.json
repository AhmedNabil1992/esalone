{
	"info": {
		"_postman_id": "8f6c3c52-7b0a-4a21-9e22-38b4f1791a24",
		"name": "PS-Web Tenant Management API",
		"description": "API collection for provisioning, checking domain availability, and deleting tenants in PS-Web.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{TENANT_PROVISIONING_API_TOKEN}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Check Domain Availability (فحص توفر الدومين)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{BASE_URL}}/api/tenants/check-domain?domain=client1.ps-web.test",
					"host": [
						"{{BASE_URL}}"
					],
					"path": [
						"api",
						"tenants",
						"check-domain"
					],
					"query": [
						{
							"key": "domain",
							"value": "client1.ps-web.test"
						}
					]
				},
				"description": "Checks whether a domain is already registered or available for a new tenant."
			},
			"response": []
		},
		{
			"name": "Provision Tenant (إنشاء تينت جديد)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"domain\": \"client1.ps-web.test\",\n  \"name\": \"Ahmed Nabil\",\n  \"email\": \"client@example.com\",\n  \"started_at\": \"2026-08-31\",\n  \"ended_at\": \"2027-08-31\",\n  \"user_id\": 101,\n  \"auto_renew\": true,\n  \"branches_limit\": 1\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{BASE_URL}}/api/tenants",
					"host": [
						"{{BASE_URL}}"
					],
					"path": [
						"api",
						"tenants"
					]
				},
				"description": "Endpoint used by external systems to asynchronously provision a new tenant database, domain, and initial super_admin users."
			},
			"response": []
		},
		{
			"name": "Delete Tenant (حذف تينت)",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{BASE_URL}}/api/tenants/{{TENANT_ID}}",
					"host": [
						"{{BASE_URL}}"
					],
					"path": [
						"api",
						"tenants",
						"{{TENANT_ID}}"
					]
				},
				"description": "Endpoint to delete a tenant and clean up its database and domains."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "BASE_URL",
			"value": "https://ps-web.test",
			"type": "string"
		},
		{
			"key": "TENANT_PROVISIONING_API_TOKEN",
			"value": "your_api_token_here",
			"type": "string"
		},
		{
			"key": "TENANT_ID",
			"value": "01J00000000000000000000000",
			"type": "string"
		}
	]
}
